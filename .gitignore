# ---------------------------------------------------------------------------
# InferHub internal build plan — task briefs for Claude Code, not part of the
# public repository. Keep these local.
#
# One exception (phase 54): plan/CLAUDE.md is the *format* the briefs are written
# in, not a brief. It is a scoped context file like the other six, the root file
# names it, and ContextContractTests resolves that pointer — so it has to exist in
# a fresh clone. The directory itself is excluded per-entry rather than wholesale,
# because git does not descend into an excluded directory and a `!` under one has
# no effect.
# ---------------------------------------------------------------------------
/plan/*
!/plan/CLAUDE.md

# ---------------------------------------------------------------------------
# .NET / Visual Studio
# ---------------------------------------------------------------------------
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Bb]uild/
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.suo
*.sln.docstates
.vs/
.vscode/
*.swp
*~

# Build results / packages
*.dll
*.exe
*.pdb
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# Rider / JetBrains
.idea/
*.sln.iml

# OS files
.DS_Store
Thumbs.db

# Secrets & local config — never commit tokens or keys
appsettings.*.Local.json
appsettings.Local.json
*.local.json
.env
.env.*
secrets.json

# Local node identity
.inferhub-node-id

# Vector-store data written by a coordinator or node run from source
# (VectorStore:DataDirectory and Vector:ReplicaDirectory both default under ./data)
src/*/data/
.claude/settings.json
__pycache__/
