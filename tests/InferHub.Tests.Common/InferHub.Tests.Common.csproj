<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 52. Fixtures, fakes and hosts, shared by the four suites. NOT a test project: it holds no
    [Fact], and `IsTestProject=false` keeps the runner from looking for one.

    It references both hosts, which is why the split does not buy build isolation (52 D3) — editing
    the coordinator still rebuilds every suite. What it buys is a RUN you can scope and files two
    agents do not share, and claiming more than that would be a design fighting itself.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <!--
    The fixtures are internal, and internals are per assembly — so the library that holds them has
    to grant them to the four suites that use them. Making them public instead would have worked and
    would have been worse: `internal` is what stops a fixture becoming an accidental API.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="InferHub.Tests.Shared" />
    <InternalsVisibleTo Include="InferHub.Tests.Coordinator" />
    <InternalsVisibleTo Include="InferHub.Tests.Node" />
    <InternalsVisibleTo Include="InferHub.Tests.Mesh" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="InferHub.Shared.OpenAi" />
    <Using Include="InferHub.Shared.Ingestion" />
    <Using Include="InferHub.Shared.Vector" />
    <Using Include="InferHub.Shared.Vector.Qdrant" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InferHub.Coordinator\InferHub.Coordinator.csproj" />
    <ProjectReference Include="..\..\src\InferHub.Node\InferHub.Node.csproj" />
    <ProjectReference Include="..\..\src\InferHub.Shared\InferHub.Shared.csproj" />
  </ItemGroup>

</Project>
