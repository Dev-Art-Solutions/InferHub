<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <UserSecretsId>dotnet-InferHub.Node-c4428961-3507-4347-90fa-545dfaed429d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      2.0.1 fixes an Int32 overflow on prompt_eval_duration: Ollama reports durations in
      nanoseconds, the field was typed int?, and anything past ~2.1s of prompt evaluation
      (i.e. every cold model) failed to deserialize and turned a good answer into a 502.
      Do not go back to 2.0.0.
    -->
    <PackageReference Include="OllamaClient" Version="2.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Solo mode (phase 37) hosts the coordinator's client-facing API on the node. This is a
      FrameworkReference, NOT a PackageReference: ASP.NET Core ships in the shared framework, so
      design rule 5 ("no new heavy dependencies") is untouched and `git diff` on this file shows no
      new package. The node image already finals on mcr.microsoft.com/dotnet/aspnet, as it always
      has, so the published size does not move either.

      Everything ASP.NET lives under LocalApi/ and nowhere else — rule 2 as amended by phase-37 D3.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InferHub.Shared\InferHub.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Phase 41. The tool runtime is internal by default (Tools/ is node plumbing, not a contract),
      and the suite that matters most for it drives real child processes through the pool, the
      manifest loader and the restart budget. The coordinator has had this since phase 9 for the
      same reason.
    -->
    <InternalsVisibleTo Include="InferHub.Tests.Common" />
    <InternalsVisibleTo Include="InferHub.Tests.Shared" />
    <InternalsVisibleTo Include="InferHub.Tests.Coordinator" />
    <InternalsVisibleTo Include="InferHub.Tests.Node" />
    <InternalsVisibleTo Include="InferHub.Tests.Mesh" />
  </ItemGroup>
</Project>
