# The one-card image (phase 87): the tools image AND the diffusion image in one container, with
# Node:OnDemand turned on so they take turns on the card instead of fighting over it.
#
#   docker build -f src/InferHub.Node/Dockerfile.all -t inferhub-node:all .
#
# WHY THIS EXISTS WHEN :diffusion DELIBERATELY DOES NOT STACK (46 D9, which is amended, not
# reversed). D9 refused stacking for two reasons. The first was size, and it still holds, which is
# why this is a separate image and :diffusion and :tools are UNCHANGED. The second was "a card
# running a diffusion pipeline has no room for a chat model beside it". Phase 85 removed that one:
# with Node:OnDemand on, the services do not run beside each other. They take turns, and the node's
# GpuArbiter enforces the turns.
#
# Two containers on one card cannot do that. Each one has its own arbiter, each arbiter believes it
# owns the card, and neither can see the other. That collision is exactly what 85 exists to prevent.
# So the box with one card and no mesh needs ONE node with every service in it, and that is this file.
# A box with several cards, or a mesh, should still compose :tools and :diffusion, as D9 says.
#
#   inferhub-node            ~340 MB, multi-arch, no engine at all                 — UNCHANGED
#   inferhub-node:ollama     ~4 GB,   amd64, Ollama inside                         — UNCHANGED
#   inferhub-node:tools      ~6 GB,   amd64, Ollama + Whisper + Piper + reranker   — UNCHANGED
#   inferhub-node:diffusion  ~12 GB,  amd64, PyTorch + diffusers                   — UNCHANGED
#   inferhub-node:all        ~11 GB,  amd64, all of the above, one venv, on demand     — this file
#
# Solo, one line, everything on one card:
#
#   docker run -d --name inferhub --gpus all \
#     -e LocalApi__Enabled=true -e Coordinator__Enabled=false \
#     -e LocalApi__ApiKeys__0=your-key \
#     -v inferhub:/data -p 5081:8080 \
#     ghcr.io/dev-art-solutions/inferhub-node:all
#
# A chat loads the chat model. An image request then waits for that chat to finish, unloads the
# chat model and loads the diffusion pipeline. A transcription stops the diffusion worker and
# starts Whisper. Each switch costs one model load, and that is the trade 85 names.
#
# Everything the two parent files say about weights (never baked in, fetched into /data/tools/hf
# in the background), voices (fetched only when Tools__Speech__Voices names one), bubblewrap (inert unless a manifest asks) and
# RequireGpu applies here unchanged. It is not repeated. Read Dockerfile.tools and
# Dockerfile.diffusion.
#
# THIS FILE IS A HAND-COPY OF BOTH, and BundledNodeTests pins the copy: the same Ollama, every import
# either parent asserts, and OnDemand on here and nowhere else. It cannot `FROM` the published
# :tools image, because the CI matrix builds every image in parallel, so that would build :all from
# the PREVIOUS release's :tools.

ARG OLLAMA_VERSION=0.32.5

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /src

COPY Directory.Build.props nuget.config ./
COPY src/InferHub.Shared/InferHub.Shared.csproj           src/InferHub.Shared/
COPY src/InferHub.Shared.Postgres/InferHub.Shared.Postgres.csproj src/InferHub.Shared.Postgres/
COPY src/InferHub.Node/InferHub.Node.csproj               src/InferHub.Node/
RUN dotnet restore src/InferHub.Node/InferHub.Node.csproj -a "$TARGETARCH"

COPY src/InferHub.Shared/          src/InferHub.Shared/
COPY src/InferHub.Shared.Postgres/ src/InferHub.Shared.Postgres/
COPY src/InferHub.Node/            src/InferHub.Node/
RUN dotnet publish src/InferHub.Node/InferHub.Node.csproj \
        -c Release -a "$TARGETARCH" --no-restore -o /app

# Ollama, pinned and checksummed, identical to Dockerfile.ollama and Dockerfile.tools on purpose.
# BundledNodeTests asserts all three stay in step.
FROM debian:trixie-slim AS ollama
ARG OLLAMA_VERSION
ARG OLLAMA_SHA256=f7d6bdbcf71b83aa8670c4e7dc4b6936c0952fcf8b114eaf6a11cbadb9684214

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl zstd \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/ollama
RUN curl -fsSL -o ollama.tar.zst \
        "https://ollama.com/download/ollama-linux-amd64.tar.zst?version=${OLLAMA_VERSION}" \
 && echo "${OLLAMA_SHA256}  ollama.tar.zst" | sha256sum -c - \
 && mkdir -p /opt/ollama \
 && zstd -d -c ollama.tar.zst | tar -x -C /opt/ollama \
 && rm ollama.tar.zst

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app .
COPY --from=ollama /opt/ollama/bin/ /usr/local/bin/
COPY --from=ollama /opt/ollama/lib/ /usr/local/lib/

# ---------------------------------------------------------------------------------------------
# ONE VENV, BOTH REQUIREMENT FILES, ONE pip CALL (87 D2). Built in this stage, for the v3.10.0
# reason both parents spell out.
#
# requirements-tools.txt pins no torch, but sentence-transformers pulls one anyway. Two venvs would
# install PyTorch twice. One `pip install -r a -r b` lets the resolver see the diffusion side's
# torch/transformers pins as constraints on the tools side. Every shipped manifest already names
# /opt/inferhub/venv/bin/python, so no manifest changes.
# ---------------------------------------------------------------------------------------------
COPY python/requirements-tools.txt     /tmp/requirements-tools.txt
COPY python/requirements-diffusion.txt /tmp/requirements-diffusion.txt

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg curl ca-certificates bubblewrap \
 && python3 -m venv /opt/inferhub/venv \
 && /opt/inferhub/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/inferhub/venv/bin/pip install --no-cache-dir \
        -r /tmp/requirements-tools.txt -r /tmp/requirements-diffusion.txt \
 && apt-get purge -y python3-venv \
 && apt-get autoremove -y \
 && rm -rf /tmp/requirements-tools.txt /tmp/requirements-diffusion.txt /var/lib/apt/lists/*

COPY python/inferhub_worker/ /opt/inferhub/inferhub_worker/
COPY python/tools/           /opt/inferhub/tools/
COPY python/recipes/         /opt/inferhub/recipes/
COPY python/manifests/       /opt/inferhub/tools/manifests/
# Phase 90: the voice catalogue — pinned entries only, no voice. Nothing is fetched unless
# Tools__Speech__Voices names one; the piper worker finds this directory next to its own.
COPY python/voices/          /opt/inferhub/voices/

# BOTH parents' assertions, every one of them. A resolution that satisfies pip but leaves either
# half unable to import fails `docker build` here, not at the first transcription or the first
# picture. BundledNodeTests checks that no import from either parent is missing below.
ENV PYTHONPATH=/opt/inferhub
RUN /opt/inferhub/venv/bin/python -c \
      "import faster_whisper, ctranslate2, piper, onnxruntime, sentence_transformers, inferhub_worker; print('tool venv ok')" \
 && /opt/inferhub/venv/bin/python -c \
      "import py_compile; py_compile.compile('/opt/inferhub/tools/whisper_worker.py', doraise=True); py_compile.compile('/opt/inferhub/tools/piper_worker.py', doraise=True); py_compile.compile('/opt/inferhub/tools/rerank_worker.py', doraise=True); print('workers compile')" \
 && /opt/inferhub/venv/bin/python -c \
      "import glob, importlib.util, os; s = importlib.util.spec_from_file_location('pw', '/opt/inferhub/tools/piper_worker.py'); pw = importlib.util.module_from_spec(s); s.loader.exec_module(pw); ids = [pw.catalogue_entry(os.path.basename(p)[:-5])['id'] for p in sorted(glob.glob('/opt/inferhub/voices/*.json'))]; assert ids, 'empty voice catalogue'; print('voice catalogue ok:', ', '.join(ids))" \
 && /opt/inferhub/venv/bin/python -c \
      "import torch, diffusers, transformers, PIL, inferhub_worker; print('diffusion venv ok')" \
 && /opt/inferhub/venv/bin/python -c \
      "import imageio; imageio.plugins.ffmpeg.get_exe(); \
       from diffusers.utils import export_to_video; print('video encoder ok')" \
 && /opt/inferhub/venv/bin/python -c \
      "import sys; from diffusers.utils import is_ftfy_available, is_peft_available; \
       sys.exit('ftfy is missing: every video request dies in WanPipeline.prompt_clean') if not is_ftfy_available() else None; \
       sys.exit('peft is missing: every LoRA recipe fails to load') if not is_peft_available() else None; \
       print('undeclared diffusers backends ok')" \
 && /opt/inferhub/venv/bin/python -c \
      "import py_compile; py_compile.compile('/opt/inferhub/tools/diffusion_worker.py', doraise=True); print('worker compiles')" \
 && /opt/inferhub/venv/bin/python -c \
      "import json, glob, sys; \
       [json.load(open(p)) for p in glob.glob('/opt/inferhub/recipes/*.json')] or sys.exit('no recipes'); \
       print('recipes parse')" \
 && /opt/inferhub/venv/bin/python -c \
      "import bitsandbytes, sentencepiece, google.protobuf; \
       from diffusers import PipelineQuantizationConfig; print('quantization ok')" \
 && /opt/inferhub/venv/bin/python -c \
      "import diffusers, json, glob, sys; \
       names = [n for p in glob.glob('/opt/inferhub/recipes/*.json') for r in [json.load(open(p))] \
                for n in (r.get('pipeline'), r.get('vaeClass')) if n]; \
       missing = sorted({n for n in names if not hasattr(diffusers, n)}); \
       sys.exit('diffusers has no: ' + ', '.join(missing)) if missing else print('pipelines ok')"

ENV NVIDIA_VISIBLE_DEVICES=all
# `compute` is not decoration. See the long version in Dockerfile.ollama.
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# The permissions trap: every directory either parent writes to, created and owned here.
RUN mkdir -p /data /data/ollama /data/tools/scratch /data/tools/hf /data/tools/voices \
 && chown -R app:app /data
ENV Vector__ReplicaDirectory=/data/vector-replicas
ENV Node__DataDirectory=/data
ENV LocalApi__Urls=http://+:8080
ENV LocalApi__Retrieval__DataDirectory=/data/retrieval
ENV OLLAMA_MODELS=/data/ollama

ENV Ollama__Endpoint=http://127.0.0.1:11434/
ENV Ollama__Supervisor__Enabled=true
ENV Ollama__Supervisor__StartAtBoot=true
ENV Ollama__Supervisor__StopOnShutdown=true

ENV Tools__Enabled=true
ENV Tools__Allowed__0=whisper
ENV Tools__Allowed__1=piper
ENV Tools__Allowed__2=rerank
ENV Tools__Allowed__3=diffusion
ENV Tools__ManifestDirectory=/opt/inferhub/tools/manifests
ENV Tools__ScratchDirectory=/data/tools/scratch

ENV Images__Jobs__DataDirectory=/data/images
ENV Tools__Image__RecipeDirectory=/opt/inferhub/recipes
ENV Tools__AllowModelDownload=true
ENV Tools__Image__RequireGpu=true

# 87 D1, AND IT IS THE REASON THIS IMAGE IS ALLOWED TO EXIST. Node:OnDemand stays false in
# appsettings.json and in every other image. Here it is on, because with it off this image IS the
# combination 46 D9 refused: Ollama's resident chat model and a diffusion pipeline fighting for the
# same VRAM. An operator with a card big enough to hold everything at once can pass
# -e Node__OnDemand__Enabled=false. That is their card and their call, as 85 leaves it.
ENV Node__OnDemand__Enabled=true

ENV PYTHONUNBUFFERED=1

USER app

ENTRYPOINT ["dotnet", "InferHub.Node.dll"]
