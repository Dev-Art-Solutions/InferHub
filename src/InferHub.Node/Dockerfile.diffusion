# The diffusion node image (phase 46): the plain node, plus a Python venv, plus a Stable Diffusion
# worker.
#
#   docker build -f src/InferHub.Node/Dockerfile.diffusion -t inferhub-node:diffusion .
#
# A FIFTH IMAGE, AND IT DELIBERATELY HAS NO OLLAMA IN IT (D9). The other three node images stack:
# :ollama is the plain one plus an engine, :tools is :ollama plus Whisper and Piper. This one does
# not, and the reason is not size alone:
#
#   1. Stacking reaches ~15 GB. Every pull pays for it, including the pulls that only wanted chat.
#   2. A card running a diffusion pipeline has no room for a chat model beside it. Bundling Ollama
#      would ship a combination the docs would then have to tell people not to use.
#   3. THE MESH IS THE COMPOSITION MECHANISM. Run :diffusion on the card and :ollama on the box next
#      to it, and the hub routes `image` to one and `chat` to the other — which is exactly what
#      phase 40's (capability, model) routing was built for, and it pays for itself again here.
#
#   inferhub-node            ~340 MB, multi-arch, no engine at all       — UNCHANGED
#   inferhub-node:ollama     ~4 GB,   amd64, Ollama inside               — UNCHANGED
#   inferhub-node:tools      ~5.6 GB, amd64, Ollama + Whisper + Piper    — UNCHANGED
#   inferhub-node:diffusion  ~12 GB,  amd64, PyTorch + diffusers         — this file
#
# A combined :all image is deferred and named in the roadmap. Revisit it if 48 GB cards become the
# norm; today it would be an image whose whole point is a configuration that does not fit.
#
# Solo, one line, with text to image:
#
#   docker run -d --name inferhub-images --gpus all \
#     -e LocalApi__Enabled=true -e Coordinator__Enabled=false \
#     -e LocalApi__ApiKeys__0=your-key \
#     -v inferhub-images:/data -p 5082:8080 \
#     ghcr.io/dev-art-solutions/inferhub-node:diffusion
#
#   curl http://localhost:5082/v1/images/generations -H "Authorization: Bearer your-key" \
#        -H 'Content-Type: application/json' \
#        -d '{"model":"sdxl","prompt":"a lighthouse in a storm, oil painting","size":"1024x1024"}' \
#     | jq -r '.data[0].b64_json' | base64 -d > out.png
#
# YOU NEED A CARD, and this image says so rather than being quietly slow: Tools:Image:RequireGpu is
# true by default and the worker refuses to start without CUDA, naming the key to unset. Unset it
# and only `sd15` is offered (512x512, tens of seconds on a modern core); `sdxl` at 1024x1024 is
# minutes and is offered only behind Tools:Image:AllowSlowCpu. Phase-39 D6's silence argument is the
# whole reason the worker's first log line names the device it picked.
#
# NO WEIGHTS ARE BAKED IN (phase-39 D7, phase-42 D4). They are fetched into /data/tools/hf, on the
# volume, so it happens once rather than once per `docker run`. That fetch is a reach onto the
# internet from a GPU box, which phase-36 D6 refuses to do without consent; here the consent is
# having chosen an image whose entire purpose is this, which is why Tools__AllowModelDownload is
# true HERE and false everywhere else.
#
# THE FETCH HAPPENS IN THE BACKGROUND, NEVER INSIDE A REQUEST (v3.14.1, and it is why that release
# exists). v3.14.0 let the download happen on first use, inside the manifest's
# requestTimeoutSeconds: on a fresh volume the first `sdxl` call spent 900 seconds downloading and
# then returned a 502, twice. Now a recipe is only DECLARED once its weights are proven loadable, a
# background thread fetches, and the worker re-declares when one lands — so `/api/status` shows
# `capabilities: []` for a few minutes on a fresh volume and then shows the models, and no caller
# ever waits on a download. Watch it with:
#
#   docker logs -f inferhub-images | grep diffusion

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /src

COPY Directory.Build.props nuget.config ./
COPY src/InferHub.Shared/InferHub.Shared.csproj  src/InferHub.Shared/
COPY src/InferHub.Node/InferHub.Node.csproj      src/InferHub.Node/
RUN dotnet restore src/InferHub.Node/InferHub.Node.csproj -a "$TARGETARCH"

COPY src/InferHub.Shared/ src/InferHub.Shared/
COPY src/InferHub.Node/   src/InferHub.Node/
RUN dotnet publish src/InferHub.Node/InferHub.Node.csproj \
        -c Release -a "$TARGETARCH" --no-restore -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app .

# ---------------------------------------------------------------------------------------------
# THE VENV IS BUILT IN THIS STAGE, AND THAT IS THE WHOLE POINT. Do not move it out.
#
# v3.10.0 shipped an image in which NOTHING IN THE VENV WAS IMPORTABLE: it was built in a
# `debian:trixie-slim` stage (Python 3.13) and COPYed into this base (3.12), and a venv's
# site-packages live under `lib/python3.13/`, which a 3.12 interpreter does not look in. Every
# manifest still loaded, the node still started, /api/status still answered — and the first
# transcription would have died on an import. Found by pulling the published image and running it,
# which is the only way this class of thing is ever found (phase-21 D7, v2.5.1, v3.0.1, v3.5.1).
#
# So the interpreter that builds the venv is the interpreter that runs it, by construction.
#
# python3-venv is build-only and is purged below. The wheels are manylinux binaries, so no compiler
# is needed — if that stops being true, add build-essential to the same purge list rather than to
# the image.
#
# curl is here because the documented way to pre-fetch weights on an air-gapped box runs inside the
# container, and on the first run of the published :tools image the documented command did not
# exist. Documentation that names a tool the image does not have fails on the one step an operator
# has to perform by hand.
#
# There is no CUDA toolkit and there does not need to be one: the torch wheel bundles its own CUDA
# runtime and reaches libcuda.so.1, which the NVIDIA container runtime injects at `docker run`
# (phase-39 D1).
# ---------------------------------------------------------------------------------------------
COPY python/requirements-diffusion.txt /tmp/requirements-diffusion.txt

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv curl ca-certificates \
 && python3 -m venv /opt/inferhub/venv \
 && /opt/inferhub/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/inferhub/venv/bin/pip install --no-cache-dir -r /tmp/requirements-diffusion.txt \
 && apt-get purge -y python3-venv \
 && apt-get autoremove -y \
 && rm -rf /tmp/requirements-diffusion.txt /var/lib/apt/lists/*

COPY python/inferhub_worker/ /opt/inferhub/inferhub_worker/
COPY python/tools/diffusion_worker.py /opt/inferhub/tools/
COPY python/recipes/  /opt/inferhub/recipes/
COPY python/manifests/diffusion.json /opt/inferhub/tools/manifests/

# The assertion that makes the v3.10.0 failure impossible to ship again: it runs at BUILD time, in
# the final image, with the exact interpreter and the exact PYTHONPATH the worker will use. A venv
# that cannot import its own libraries now fails `docker build` instead of the first generation
# somebody attempts on a box they have just set up.
ENV PYTHONPATH=/opt/inferhub
RUN /opt/inferhub/venv/bin/python -c \
      "import torch, diffusers, transformers, PIL, inferhub_worker; print('diffusion venv ok')" \
 && /opt/inferhub/venv/bin/python -c \
      "import imageio; imageio.plugins.ffmpeg.get_exe(); \
       from diffusers.utils import export_to_video; print('video encoder ok')" \
 && /opt/inferhub/venv/bin/python -c \
      "import sys; from diffusers.utils import is_ftfy_available, is_peft_available; \
       sys.exit('ftfy is missing: every video request dies in WanPipeline.prompt_clean') if not is_ftfy_available() else None; \
       sys.exit('peft is missing: every LoRA recipe fails to load') if not is_peft_available() else None; \
       print('undeclared diffusers backends ok')" \
 && /opt/inferhub/venv/bin/python -c \
      "import py_compile; py_compile.compile('/opt/inferhub/tools/diffusion_worker.py', doraise=True); print('worker compiles')" \
 && /opt/inferhub/venv/bin/python -c \
      "import json, glob, sys; \
       [json.load(open(p)) for p in glob.glob('/opt/inferhub/recipes/*.json')] or sys.exit('no recipes'); \
       print('recipes parse')" \
 && /opt/inferhub/venv/bin/python -c \
      "import bitsandbytes, sentencepiece, google.protobuf; \
       from diffusers import PipelineQuantizationConfig; print('quantization ok')" \
 && /opt/inferhub/venv/bin/python -c \
      "import diffusers, json, glob, sys; \
       names = [n for p in glob.glob('/opt/inferhub/recipes/*.json') for r in [json.load(open(p))] \
                for n in (r.get('pipeline'), r.get('vaeClass')) if n]; \
       missing = sorted({n for n in names if not hasattr(diffusers, n)}); \
       sys.exit('diffusers has no: ' + ', '.join(missing)) if missing else print('pipelines ok')"

ENV NVIDIA_VISIBLE_DEVICES=all
# `compute` is not decoration. The container runtime's default is `utility`, which gives a working
# nvidia-smi and NO libcuda — every diagnostic looks right and everything runs on the CPU at a
# fiftieth of the speed with no error anywhere. See the long version in Dockerfile.ollama.
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# THE PERMISSIONS TRAP, for the seventh time (phase-21 D7, the node id, phase-30 D3, phase-38 D4,
# phase-41 D5, phase-42). `USER app` cannot write /app, and Docker seeds a fresh named volume's
# ownership from the image's mount point — so a directory the image does not contain is created
# root-owned and the first write fails at runtime, on somebody else's machine, after the release.
#
# Every path below is one this image writes to: scratch per request, model weights, vector replicas,
# the node id, the corpus.
RUN mkdir -p /data /data/tools/scratch /data/tools/hf \
 && chown -R app:app /data
ENV Vector__ReplicaDirectory=/data/vector-replicas
ENV Node__DataDirectory=/data
ENV LocalApi__Urls=http://+:8080
ENV LocalApi__Retrieval__DataDirectory=/data/retrieval

# The two opt-ins, both satisfied here and NEITHER of them collapsible into the other (phase-41 D2).
# `Enabled` consents to the feature; `Allowed` names the manifests that may start, and it is the
# ceiling phase 43's coordinator-driven profiles can never raise.
ENV Tools__Enabled=true
ENV Tools__Allowed__0=diffusion
ENV Tools__ManifestDirectory=/opt/inferhub/tools/manifests
ENV Tools__ScratchDirectory=/data/tools/scratch

# Durable image jobs (phase 56): the same trap a seventh time, and the first one that holds user
# content. Inert unless Images__Jobs__Persistence=file; with it on, a finished picture lives here
# for Images__Jobs__RetentionSeconds and is unlinked the moment it is delivered or expires.
ENV Images__Jobs__DataDirectory=/data/images
ENV Tools__Image__RecipeDirectory=/opt/inferhub/recipes

# The third opt-in (phase-42 D4). True HERE and nowhere else: choosing this image *is* the consent to
# fetch weights, exactly as choosing :ollama is the consent to run an Ollama. The worker names what
# it is fetching before it starts, and the cache is on the volume so it happens once.
ENV Tools__AllowModelDownload=true

# The fourth (phase-46 D7), and it is a REFUSAL rather than a grant: without a reachable CUDA device
# the worker will not start, and says which key to unset. A tool that loads happily on a CPU and then
# serves four-minute requests is a node the fleet keeps routing to, and every caller pays for the
# discovery. Left at its default here on purpose — this image exists for people with a card.
ENV Tools__Image__RequireGpu=true

ENV PYTHONUNBUFFERED=1

USER app

ENTRYPOINT ["dotnet", "InferHub.Node.dll"]
