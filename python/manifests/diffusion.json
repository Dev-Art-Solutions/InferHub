{
  "id": "diffusion",
  "capabilities": [
    {
      "kind": "image",
      "models": []
    },
    {
      "kind": "image-edit",
      "models": []
    }
  ],
  "command": ["/opt/inferhub/venv/bin/python", "-u", "/opt/inferhub/tools/diffusion_worker.py"],
  "workdir": "/opt/inferhub/tools",
  "env": {
    "HF_HOME": "/data/tools/hf",
    "OMP_NUM_THREADS": "4",
    "LD_LIBRARY_PATH": "/usr/local/lib/ollama/cuda_v12:/usr/local/lib/ollama/cuda_v13"
  },
  "minWorkers": 0,
  "maxWorkers": 1,
  "startTimeoutSeconds": 600,
  "requestTimeoutSeconds": 900,
  "idleTimeoutSeconds": 1800
}
